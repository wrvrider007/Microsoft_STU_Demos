      "create": {
        "method": "POST",
        "uri": "{{graph-endpoint}}/v1.0/identity/conditionalAccess/policies",
        "body": {
          "displayName": "TCG01: Require MFA for all users",
          "state": "enabledForReportingButNotEnforced",
          "conditions": {
            "clientAppTypes": ["all"],
            "applications": { "includeApplications": ["All"] },
            "users": {
              "includeUsers": ["All"],
              "excludeGroups": ["{{emergencyAccess.id}}"]
