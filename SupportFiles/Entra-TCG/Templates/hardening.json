{
  "template": "hardening",
  "version": "1.2.0",
  "updated": "2026-10-06",
  "description": "Required Entra hardening: emergency exclusion group, default creator restrictions, legacy owner-consent setting, PIM Admin context, and TCG01-TCG10 (created report-only). REQUIRED FOLLOW-ON: targeted user-consent update, Limited-or-stricter guest access, effective consent verification, eligible-admin PR-MFA coverage and native PIM settings, including attaching the PIM Admin context after its policies are enabled and validated. Existing policies are not upgraded or renamed.",
  "graphScopes": {
    "delegated": [
      "Group.ReadWrite.All",
      "Policy.ReadWrite.Authorization",
      "Policy.ReadWrite.ConditionalAccess",
      "Policy.Read.All",
      "GroupSettings.ReadWrite.All",
      "AuthenticationContext.ReadWrite.All"
    ],
    "application": [
      "Group.ReadWrite.All",
      "Policy.ReadWrite.Authorization",
      "Policy.ReadWrite.ConditionalAccess",
      "Policy.Read.All",
      "Directory.ReadWrite.All",
      "AuthenticationContext.ReadWrite.All"
